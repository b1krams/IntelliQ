# ==============================================================================
# IntelliQ Environment Configuration ($0 Idle / Free-Tier Maximized)
# ==============================================================================

# LLM Providers (Free Tiers & Cascade)
# Primary: Google Gemini API Free Tier (Get key at https://aistudio.google.com)
GEMINI_API_KEY=AQ...
GEMINI_MODEL=

# Secondary Free Tier: Groq Cloud (Ultra-fast Llama 3.3 70B / Mixtral)
GROQ_API_KEY=gsk_...
GROQ_MODEL=

# Fallback (Optional): OpenRouter or direct OpenAI/Anthropic
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS & Infrastructure Configuration
AWS_REGION=us-east-1
APP_NAME=intelliq
STAGE=dev

# DynamoDB Configuration
# In SST, defaults to PROVISIONED with 10 RCU / 10 WCU (Always-Free Tier)
DYNAMODB_BILLING_MODE=PROVISIONED
DYNAMODB_TABLE_NAME=

# S3 Storage
S3_BUCKET_NAME=

# Cognito Authentication (Lite Tier)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
ALLOWED_EMAIL_DOMAINS=*

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=300
